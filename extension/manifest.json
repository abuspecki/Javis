{
  "manifest_version": 3,
  "name": "J.A.R.V.I.S. Control Interface",
  "short_name": "J.A.R.V.I.S.",
  "version": "1.0.0",
  "description": "Futuristisches KI-Kontrollzentrum als neuer Tab: Sprachsteuerung, Browser-Steuerung, Systemmonitor.",
  "icons": { "128": "favicon.svg" },
  "action": { "default_title": "J.A.R.V.I.S. öffnen" },
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabs", "downloads", "system.cpu", "system.memory", "storage"],
  "host_permissions": ["http://localhost:8787/*"],
  "commands": {
    "open-jarvis": { "suggested_key": { "default": "Ctrl+Shift+J", "mac": "Command+Shift+J" }, "description": "J.A.R.V.I.S. öffnen" }
  }
}
